# ============================================================
# Supabase (this repo's own project — see supabase/config.toml)
# ============================================================
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=

# The MCP server signs in as a real wms.memberships row with role=
# PROCESS_AGENT (see supabase/seed.sql) rather than using the service_role
# key, so RLS/role checks inside the wms_* RPCs (which read auth.uid())
# apply the same way they do for human users — the browser never gets a
# service_role key either way (design.md D3).
WMS_PROCESS_AGENT_EMAIL=process-agent-a@demo.local
WMS_PROCESS_AGENT_PASSWORD=Demo1234!

# The WCS equipment-control tools that report *back* from the equipment side
# (report_command_result / report_equipment_status / raise_equipment_fault)
# sign in as a separate WCS_GATEWAY identity instead. RLS keeps the two apart
# on purpose: PROCESS_AGENT issues commands, WCS_GATEWAY reports results, and
# neither of them may resolve a fault — that needs a human WCS_OPERATOR.
WMS_WCS_GATEWAY_EMAIL=wcs-gateway-a@demo.local
WMS_WCS_GATEWAY_PASSWORD=Demo1234!

# The natural-language audit log tools (query_audit_log / export_audit_log)
# sign in as a read-only AUDITOR identity. That role has been in the schema's
# role comment since the first migration and this contract is its first real
# use: it may read and export the audit log and do nothing else. PROCESS_AGENT
# is refused by the RPC itself, so this is not a convenience — it is the only
# identity that works.
WMS_AUDITOR_EMAIL=auditor-a@demo.local
WMS_AUDITOR_PASSWORD=Demo1234!

# ============================================================
# Server
# ============================================================
WMS_MCP_PORT=8199
