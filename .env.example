# Read by `docker compose` itself (not by the containers) to fill in
# wms-frontend's build-time-free runtime config in docker-compose.yml.
# Copy to .env and fill in the SAME production Supabase project's URL/anon
# key used in mcp/.env.prod (see mcp/.env.example for that file's full set
# of variables). Never put the service_role key here — this file's values
# end up in the browser via the frontend's env.js.

SUPABASE_URL=
SUPABASE_ANON_KEY=
